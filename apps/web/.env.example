# Optional MapLibre style override. The default development style is the
# OpenFreeMap Liberty vector style, recolored at runtime by Observatory.
# NEXT_PUBLIC_BASE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional when apps/web is launched from outside the monorepo root.
# KRISTAL_REPO_ROOT=C:\\path\\to\\kristal-farms


# Satellite imagery is local/static. No satellite API key is required.
# Publish tiles with pipelines/imagery/build_local_satellite.py.
