+                <span>{humanizeToken(facility.type)}</span>
+                <strong>{facility.label}</strong>
+                <em>{facility.length_m != null ? `${facility.length_m.toLocaleString("en-CA")} m` : "dimension not verified"}</em>
+              </article>
+            ))}
+          </div>
+
+          <div className={styles.loadBox}>
