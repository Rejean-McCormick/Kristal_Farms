+        <Link href="/?section=villages" className={styles.backLink}>← Villages</Link>
+        <div className={styles.dossierHeaderTitle}>
+          <span>KRISTAL FARMS · TARGET VILLAGE DOSSIER</span>
+          <strong>{village.name}</strong>
